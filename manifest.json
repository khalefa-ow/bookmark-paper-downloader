{
  "manifest_version": 3,
  "name": "Bookmark Paper Sweeper",
  "version": "2.0.0",
  "description": "Collect and organize open tabs, classify bookmarks and papers, remove duplicates, and download PDFs.",
  "permissions": ["bookmarks", "downloads", "favicon", "storage", "tabs", "tabGroups"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bookmark Paper Sweeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
