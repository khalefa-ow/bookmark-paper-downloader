{
  "manifest_version": 3,
  "name": "Bookmark Paper Sweeper",
  "version": "1.8.0",
  "description": "Classify bookmarks, current tab groups, and open tabs; remove duplicates and download papers.",
  "permissions": ["bookmarks", "downloads", "storage", "tabs", "tabGroups"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bookmark Paper Sweeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
